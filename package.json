{
  "name": "@frani/values-object",
  "version": "1.0.0",
  "description": "A library for creating and managing values objects",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint-staged": "lint-staged",
    "docs:dev": "cd documentation && mintlify dev",
    "docs:install": "mintlify install",
    "prebuild": "rm -rf dist",
    "build:watch": "tsup watch",
    "build:prod": "tsup src/index.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "mintlify": "^4.2.616",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "src/**/*.ts": "vitest related --run",
    "tests/**/*.ts": "vitest related --run"
  }
}
